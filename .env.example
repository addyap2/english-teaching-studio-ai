# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables. Never commit real values.

# --- AI provider (optional) -------------------------------------------------
# Without any key the studio still works: use "Generate with Claude.ai"
# (copy/paste, covered by a Claude Pro subscription) and the sample lesson.
#
# Claude API (recommended). Create a key at https://console.anthropic.com
# API usage is billed separately from a Claude Pro subscription.
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5 (best quality). claude-sonnet-5-5 costs
# about half as much; claude-haiku-5-5 is far cheaper but less polished.
ANTHROPIC_MODEL=

# OpenAI (alternative). Used only if no Anthropic key is set, or if
# AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_PROVIDER=

# --- Access control (required in production when a key is set) -------------
# A private passphrase you type in the studio before generating. It stops
# strangers who find your URL from spending your API credit.
APP_ACCESS_KEY=
